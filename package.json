{
  "name": "eh3-dsh-harness-share",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Share selected theme settings, installed plugins and skills by QR code, then review and install them together from an image or screenshot.",
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.9.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "INSTALL.md",
    "SECURITY.md",
    "docs",
    "screenshots.json",
    "QR-PROTOCOL.md",
    "NOTICE.md",
    "licenses",
    "DEPENDENCIES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "notices": "node scripts/collect-notices.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@types/node": "24.19.2",
    "esbuild": "0.27.0",
    "typescript": "~5.9.3",
    "@ant-design/icons": "6.3.4",
    "@gsap/react": "2.1.2",
    "antd": "6.7.0",
    "gsap": "3.15.1",
    "pts": "1.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@rc-component/qrcode": "2.0.0"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ww-Cooooo/harness-share-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/Ww-Cooooo/harness-share-dsh/issues"
  },
  "homepage": "https://github.com/Ww-Cooooo/harness-share-dsh#readme",
  "license": "MIT"
}
